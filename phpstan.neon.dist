includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - src
        - config
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    noEnvCallsOutsideOfConfig: false
    ignoreErrors:
        # WarmCache::crawl() calls the API of spatie/crawler 8 or 9, whichever is installed.
        -
            message: '#Spatie\\+Crawler\\+Crawler#'
            path: src/Commands/WarmCache.php
            reportUnmatched: false
